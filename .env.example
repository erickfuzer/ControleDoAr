# Copy to .env (never commit it). Values are read at build time by src-tauri/build.rs.

# OAuth app created with `smartthings apps:create -i docs/smartthings-app.json` (see README).
# Without these, the app still works with a Personal Access Token typed in the login screen.
ARCOND_CLIENT_ID=
ARCOND_CLIENT_SECRET=

# Optional, development builds only: a Personal Access Token used when nobody is signed in.
SMARTTHINGS_PAT=
