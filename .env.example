# Copie para .env (nunca faça commit dele). Os valores são lidos na compilação pelo src-tauri/build.rs.

# App OAuth criado com `smartthings apps:create -i docs/smartthings-app.json` (veja o README).
# Sem eles, o app continua funcionando com um token pessoal (PAT) digitado na tela de login.
ARCOND_CLIENT_ID=
ARCOND_CLIENT_SECRET=

# Opcional, só em builds de desenvolvimento: token pessoal usado quando ninguém está logado.
SMARTTHINGS_PAT=
